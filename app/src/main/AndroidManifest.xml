<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.DETECT_SCREEN_CAPTURE" />

    <application
        android:name=".app.SauceTrackerApplication"
        android:allowBackup="true"
        android:icon="@drawable/app_icon"
        android:roundIcon="@drawable/app_icon"
        android:label="@string/app_name"
        android:theme="@style/Theme.SauceTracker">
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            tools:node="remove" />
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
        <activity
            android:name=".feature.qr.QrShareActivity"
            android:exported="false" />
        <activity
            android:name=".feature.browser.GalleryBrowserActivity"
            android:exported="false" />
        <activity
            android:name=".feature.slideshow.GallerySlideshowActivity"
            android:exported="false" />
        <activity
            android:name=".feature.experimentalgallery.LocalDownloadedGalleryActivity"
            android:exported="false" />
        <activity
            android:name=".feature.experimentalgallery.ExperimentalGalleryActivity"
            android:exported="false" />
        <!-- Version Museum deferred beyond 2.0; implementation is retained.
        <activity
            android:name=".feature.experimentalgallery.VersionMuseumActivity"
            android:exported="false" />
        -->
        <activity
            android:name=".app.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="image/*" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".app.GitHubMediaLauncher"
            android:targetActivity=".app.MainActivity"
            android:exported="true"
            android:process=":githubmedia"
            android:permission="android.permission.DUMP" />
    </application>

</manifest>
